---
import FormattedDate from '../components/FormattedDate.astro';
import WritingShell from '../components/WritingShell.astro';
import type { WritingPost, WritingSubcollection } from '../lib/writing';
import {
	getSubcollectionSlug,
	getSubcollectionTitle,
} from '../lib/writing';

interface Props {
	post: WritingPost;
	subcollections?: WritingSubcollection[];
}

const { post, subcollections = [] } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
const subcollectionSlug = getSubcollectionSlug(post);
const subcollection = subcollectionSlug
	? {
			slug: subcollectionSlug,
			title: getSubcollectionTitle(subcollectionSlug, subcollections),
		}
	: undefined;
---

<WritingShell
	title={`${title} — ${subcollection ? `${subcollection.title} — ` : ''}Writing by Idan Gazit`}
	{description}
	pageType="article"
	{subcollection}
>
	<article class="pt-[clamp(3rem,9vw,6rem)] pb-20">
		<header class="mx-auto w-full max-w-[42rem]">
			<nav class="flex flex-wrap gap-x-[0.8rem] gap-y-[0.45rem] font-sans text-xs uppercase tracking-[0.1em] text-primary-400" aria-label="Breadcrumb">
				<a class="text-primary-300 no-underline" href="/writing/">Writing</a>
				{subcollection && (
					<>
						<span aria-hidden="true">/</span>
						<a class="text-primary-300 no-underline" href={`/writing/${subcollection.slug}/`}>{subcollection.title}</a>
					</>
				)}
			</nav>
			<h1 class="mt-[1.2rem] mb-0 text-[clamp(2.5rem,9vw,4.75rem)] leading-[0.98] font-medium tracking-[-0.025em] text-primary-50">{title}</h1>
			<p class="my-6 text-[clamp(1.2rem,3vw,1.45rem)] leading-[1.45] text-primary-300">{description}</p>
			<div class="flex flex-wrap gap-x-[0.8rem] gap-y-[0.45rem] font-sans text-xs uppercase tracking-[0.1em] text-primary-400">
				<span>Published <FormattedDate date={pubDate} /></span>
				{updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
			</div>
		</header>

		{heroImage && <img class="mx-auto my-12 w-full rounded-lg" src={heroImage} alt="" />}

		<div class="mx-auto mt-14 w-full max-w-[42rem] text-[1.12rem] leading-[1.75] text-primary-100
			[&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:text-[2rem]
			[&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-2xl
			[&_h2]:leading-[1.2] [&_h3]:leading-[1.2] [&_h4]:leading-[1.2]
			[&_h2]:font-medium [&_h3]:font-medium [&_h4]:font-medium
			[&_h2]:text-primary-50 [&_h3]:text-primary-50 [&_h4]:text-primary-50
			[&_p]:my-5 [&_ul]:my-5 [&_ol]:my-5 [&_blockquote]:my-5 [&_pre]:my-5
			[&_ul]:pl-6 [&_ol]:pl-6
			[&_blockquote]:border-l-[3px] [&_blockquote]:border-primary-600 [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-primary-300
			[&_code]:text-[0.88em]
			[&_pre]:overflow-x-auto [&_pre]:rounded-[0.35rem] [&_pre]:border [&_pre]:border-primary-700 [&_pre]:bg-primary-950 [&_pre]:p-4
			[&_img]:h-auto [&_img]:max-w-full [&_img]:rounded-[0.35rem]">
			<slot />
		</div>
	</article>
</WritingShell>
