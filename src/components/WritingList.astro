---
import FormattedDate from './FormattedDate.astro';
import PhosphorIcon from './PhosphorIcon.astro';
import type { WritingPost, WritingSubcollection } from '../lib/writing';
import {
	getSubcollectionSlug,
	getSubcollectionTitle,
	getWritingPostUrl,
} from '../lib/writing';

interface Props {
	posts: WritingPost[];
	subcollections?: WritingSubcollection[];
	showCollection?: boolean;
}

const { posts, subcollections = [], showCollection = true } = Astro.props;
---

{
	posts.length > 0 ? (
		<ol class="m-0 list-none p-0">
			{posts.map((post) => {
				const subcollection = getSubcollectionSlug(post);
				return (
					<li class="py-8">
						<div class="mb-[0.45rem] flex items-center gap-2 font-sans text-xs uppercase tracking-[0.1em] text-primary-400">
							<FormattedDate date={post.data.pubDate} />
							{subcollection && showCollection && (
								<a class="flex items-center gap-1.5 text-primary-300 no-underline" href={`/writing/${subcollection}/`}>
									<PhosphorIcon name="cards-three" size={14} />
									<span>{getSubcollectionTitle(subcollection, subcollections)}</span>
								</a>
							)}
						</div>
						<h2 class="m-0 text-[clamp(1.55rem,5vw,2rem)] font-medium leading-[1.15]"><a class="no-underline" href={getWritingPostUrl(post)}>{post.data.title}</a></h2>
						<p class="mt-[0.65rem] mb-0 max-w-[40rem] text-[1.05rem] leading-[1.55] text-primary-300">{post.data.description}</p>
					</li>
				);
			})}
		</ol>
	) : (
		<p class="my-0 py-12 text-[1.05rem] leading-[1.55] text-primary-300">Nothing here yet. Check back soon.</p>
	)
}
